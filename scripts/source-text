#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Extract the text of a Wayback Machine snapshot (HTML, PDF or plain text).

Usage:
  scripts/source-text <wayback-archive-url>
  scripts/source-text --print-url <wayback-archive-url>
  scripts/source-text --file <local-path>

The only sanctioned way for agents to retrieve exact source wording for quotes.

The snapshot URL must carry the full 14-digit timestamp. Wayback answers an
unknown timestamp by redirecting to the nearest capture; that is treated as an
error, so the text always comes from the snapshot the ledger records.

Output is normalised (see normalise_text): the quote-match check must apply the
same function to both the ledger quote and this output.

Exit codes:
  0  text written to stdout
  1  source problem: snapshot missing, redirected to another capture, no
     extractable text, or text that cannot be decoded (candidate for
     match = "manual")
  2  usage error: bad arguments, not a full Wayback snapshot URL, missing file
  3  inconclusive: network failure, timeout or server error; try again later
"""

from __future__ import annotations

import argparse
import gzip
import html
from html.parser import HTMLParser
import http.client
from pathlib import Path
import re
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.request
import zlib

EXIT_OK = 0
EXIT_SOURCE = 1
EXIT_USAGE = 2
EXIT_INCONCLUSIVE = 3

WAYBACK_RE = re.compile(
    r"^https?://web\.archive\.org/web/(\d+)([a-z]{2}_)?/(https?://.+)$",
    re.IGNORECASE,
)
META_CHARSET_RE = re.compile(
    rb"""<meta[^>]+charset\s*=\s*["']?\s*([A-Za-z0-9._:-]+)""",
    re.IGNORECASE,
)

# Browsers read these labels as windows-1252 (WHATWG Encoding Standard).
WINDOWS_1252_LABELS = {"iso-8859-1", "iso8859-1", "latin-1", "latin1", "ascii", "us-ascii"}

# Characters that look like a space, and characters that are invisible.
SPACE_LIKE = (
    "\u00a0"  # no-break space
    "\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a"  # en space to hair space
    "\u202f"  # narrow no-break space
    "\u205f"  # medium mathematical space
    "\u3000"  # ideographic space
)
INVISIBLE = (
    "\u00ad"  # soft hyphen
    "\u200b\u200c\u200d"  # zero-width space, non-joiner, joiner
    "\u2060"  # word joiner
    "\ufeff"  # zero-width no-break space (stray byte-order mark)
)
_TRANSLATION = {**{ord(c): " " for c in SPACE_LIKE}, **{ord(c): None for c in INVISIBLE}}

SKIP_TAGS = {"script", "style", "noscript", "svg", "template"}
BLOCK_TAGS = {
    "address",
    "article",
    "aside",
    "blockquote",
    "br",
    "dd",
    "div",
    "dl",
    "dt",
    "figcaption",
    "figure",
    "footer",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "header",
    "hr",
    "li",
    "main",
    "nav",
    "ol",
    "p",
    "pre",
    "section",
    "table",
    "tr",
    "ul",
}
CELL_TAGS = {"td", "th"}


class SourceError(Exception):
    """The snapshot itself cannot give usable text (exit 1)."""


class InconclusiveError(Exception):
    """The attempt failed for a reason that may pass (exit 3)."""


def normalise_text(text: str) -> str:
    """The one normalisation shared by extraction and quote matching.

    - Unicode NFC (composes accents). Not NFKC: that would turn "m²" into "m2"
      and "10⁶" into "106".
    - No-break and typographic spaces become a plain space; soft hyphens and
      zero-width characters are removed.
    - Runs of spaces and tabs collapse to one space; lines are trimmed and
      blank lines dropped.
    - Form feeds (PDF page breaks) are kept, so page numbers can be counted.
    """
    text = unicodedata.normalize("NFC", text).translate(_TRANSLATION)
    pages = []
    for page in text.split("\f"):
        lines = []
        for line in re.split(r"\r\n|\r|\n", page):
            cleaned = re.sub(r"[ \t\v]+", " ", line).strip()
            if cleaned:
                lines.append(cleaned)
        pages.append("\n".join(lines) + ("\n" if lines else ""))
    return "\f".join(pages)


class _HTMLTextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=False)
        self._skip_depth = 0
        self._parts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        t = tag.lower()
        if t in SKIP_TAGS:
            self._skip_depth += 1
        elif self._skip_depth == 0:
            if t in BLOCK_TAGS:
                self._parts.append("\n")
            elif t in CELL_TAGS:
                self._parts.append("\t")

    def handle_endtag(self, tag: str) -> None:
        t = tag.lower()
        if t in SKIP_TAGS and self._skip_depth > 0:
            self._skip_depth -= 1
        elif self._skip_depth == 0 and t in BLOCK_TAGS:
            self._parts.append("\n")

    def handle_data(self, data: str) -> None:
        if self._skip_depth == 0:
            self._parts.append(data)

    def handle_entityref(self, name: str) -> None:
        if self._skip_depth == 0:
            self._parts.append(html.unescape(f"&{name};"))

    def handle_charref(self, name: str) -> None:
        if self._skip_depth == 0:
            self._parts.append(html.unescape(f"&#{name};"))

    def text(self) -> str:
        return "".join(self._parts)


def parse_wayback_url(url: str) -> tuple[str, str]:
    """Return (timestamp, target) of a Wayback snapshot URL, or raise ValueError."""
    match = WAYBACK_RE.match(url.strip())
    if not match:
        raise ValueError(
            "URL must be a Wayback Machine snapshot "
            "(https://web.archive.org/web/<timestamp>/<target-url>)."
        )
    timestamp, _modifier, target = match.groups()
    return timestamp, target


def normalise_wayback_url(url: str) -> str:
    """Validate a snapshot URL and return its raw (`id_`) form."""
    timestamp, target = parse_wayback_url(url)
    if len(timestamp) != 14:
        raise ValueError(
            "Snapshot URL needs the full 14-digit timestamp (YYYYMMDDhhmmss), "
            f"got {len(timestamp)} digits. Open the snapshot and copy its exact URL; "
            "never build an archive URL by hand."
        )
    return f"https://web.archive.org/web/{timestamp}id_/{target}"


def check_snapshot(requested_url: str, final_url: str) -> None:
    """Fail if Wayback served a different capture than the one requested."""
    requested_timestamp, _ = parse_wayback_url(requested_url)
    try:
        final_timestamp, _ = parse_wayback_url(final_url)
    except ValueError:
        final_timestamp = ""
    if final_timestamp != requested_timestamp:
        raise SourceError(
            f"No capture at timestamp {requested_timestamp}; Wayback redirected to "
            f"{final_url}. Check that capture shows the right content and record "
            "its exact URL instead."
        )


def decode_body(data: bytes, content_encoding: str = "") -> bytes:
    """Undo HTTP content encoding. Raw captures come back as they were stored."""
    encodings = [e.strip().lower() for e in content_encoding.split(",") if e.strip()]
    try:
        for encoding in reversed(encodings):
            if encoding in ("gzip", "x-gzip"):
                data = gzip.decompress(data)
            elif encoding == "deflate":
                try:
                    data = zlib.decompress(data)
                except zlib.error:
                    data = zlib.decompress(data, -zlib.MAX_WBITS)
            elif encoding != "identity":
                raise SourceError(
                    f"Unsupported content encoding '{encoding}'; this capture "
                    "cannot be read automatically."
                )
        if data.startswith(b"\x1f\x8b"):
            data = gzip.decompress(data)
    except (OSError, EOFError, zlib.error) as exc:
        raise InconclusiveError(f"Could not decompress the response: {exc}") from exc
    return data


def fetch_url(url: str, timeout: int = 30) -> tuple[bytes, str, str]:
    """Return (body, content type, final URL after redirects)."""
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "earthmania-source-text/0.1 (+https://earthmania.org)",
            "Accept": "text/html,application/pdf,text/plain;q=0.9,*/*;q=0.5",
            "Accept-Encoding": "gzip",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            content_type = resp.headers.get("Content-Type") or ""
            content_encoding = resp.headers.get("Content-Encoding") or ""
            final_url = resp.geturl()
            data = resp.read()
    except urllib.error.HTTPError as exc:
        message = f"HTTP {exc.code} fetching {url}: {exc.reason}"
        if exc.code == 429 or exc.code >= 500:
            raise InconclusiveError(message) from exc
        raise SourceError(message) from exc
    except urllib.error.URLError as exc:
        raise InconclusiveError(f"Network error fetching {url}: {exc.reason}") from exc
    except (OSError, http.client.HTTPException) as exc:
        raise InconclusiveError(f"Network error fetching {url}: {exc}") from exc

    data = decode_body(data, content_encoding)
    if not data:
        raise SourceError(f"Empty response body from {url}")
    return data, content_type, final_url


def decode_text(data: bytes, content_type: str = "", encoding: str | None = None, sniff_meta: bool = False) -> str:
    """Decode bytes strictly. Never substitute replacement characters."""
    if encoding:
        candidates = [encoding]
    else:
        candidates = []
        if data.startswith(b"\xef\xbb\xbf"):
            candidates.append("utf-8-sig")
        elif data.startswith((b"\xff\xfe", b"\xfe\xff")):
            candidates.append("utf-16")
        header = re.search(r"charset=([^\s;]+)", content_type, re.IGNORECASE)
        if header:
            candidates.append(header.group(1).strip("\"'"))
        if sniff_meta:
            meta = META_CHARSET_RE.search(data[:4096])
            if meta:
                candidates.append(meta.group(1).decode("ascii", errors="ignore"))
        candidates.append("utf-8")

    for label in candidates:
        codec = "cp1252" if label.lower() in WINDOWS_1252_LABELS else label
        try:
            return data.decode(codec)
        except (LookupError, UnicodeDecodeError):
            continue
    raise SourceError(
        f"Text could not be decoded (tried: {', '.join(candidates)}). "
        "Pass --encoding <name> if the page's encoding is known."
    )


def extract_pdf_text(data: bytes) -> str:
    try:
        proc = subprocess.run(
            ["pdftotext", "-enc", "UTF-8", "-", "-"],
            input=data,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError as exc:
        raise SourceError("pdftotext is required to extract PDF text.") from exc

    if proc.returncode != 0:
        err = proc.stderr.decode("utf-8", errors="replace").strip()
        raise SourceError(f"pdftotext failed (exit {proc.returncode}): {err}")

    text = normalise_text(proc.stdout.decode("utf-8", errors="strict"))
    if not text.strip():
        raise SourceError(
            "PDF contains no extractable text (likely scanned image); "
            "record claim with match = 'manual' and match_reason."
        )
    return text


def extract_html_text(data: bytes, content_type: str = "", encoding: str | None = None) -> str:
    decoded = decode_text(data, content_type=content_type, encoding=encoding, sniff_meta=True)
    parser = _HTMLTextExtractor()
    parser.feed(decoded)
    parser.close()
    text = normalise_text(parser.text())
    if not text.strip():
        raise SourceError("HTML document produced no extractable text.")
    return text


def extract_text(data: bytes, content_type: str = "", source_hint: str = "", encoding: str | None = None) -> str:
    ct = content_type.lower()
    hint = source_hint.lower()
    if "application/pdf" in ct or data.startswith(b"%PDF-") or hint.endswith(".pdf"):
        return extract_pdf_text(data)
    if "text/plain" in ct or hint.endswith(".txt"):
        text = normalise_text(decode_text(data, content_type=content_type, encoding=encoding))
        if not text.strip():
            raise SourceError("Plain-text document is empty.")
        return text
    return extract_html_text(data, content_type=content_type, encoding=encoding)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scripts/source-text",
        description="Write the text of a Wayback Machine snapshot (HTML/PDF/text) to stdout.",
        epilog="Exit codes: 0 text written; 1 source problem; 2 usage error; 3 inconclusive (network).",
    )
    parser.add_argument(
        "url",
        nargs="?",
        help="Wayback snapshot URL with full timestamp (https://web.archive.org/web/<14 digits>/<url>).",
    )
    parser.add_argument(
        "--file",
        dest="file_path",
        help="Read from a local HTML/PDF/text file instead of fetching over the network (for tests).",
    )
    parser.add_argument(
        "--print-url",
        action="store_true",
        help="Print the normalised raw Wayback URL and exit without fetching.",
    )
    parser.add_argument(
        "--encoding",
        help="Text encoding to use instead of the detected one (HTML and plain text).",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=30,
        help="HTTP timeout in seconds (default: 30).",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.file_path and args.url:
        parser.error("Specify either an archive URL or --file, not both.")
    if not args.file_path and not args.url:
        parser.error("An archive URL (or --file) is required.")

    try:
        if args.file_path:
            path = Path(args.file_path)
            if not path.is_file():
                raise ValueError(f"File not found: {path}")
            text = extract_text(path.read_bytes(), source_hint=path.name, encoding=args.encoding)
            sys.stdout.write(text)
            return EXIT_OK

        raw_url = normalise_wayback_url(args.url)
        if args.print_url:
            sys.stdout.write(raw_url + "\n")
            return EXIT_OK

        data, content_type, final_url = fetch_url(raw_url, timeout=args.timeout)
        check_snapshot(raw_url, final_url)
        text = extract_text(data, content_type=content_type, source_hint=raw_url, encoding=args.encoding)
        sys.stdout.write(text)
        return EXIT_OK
    except ValueError as exc:
        sys.stderr.write(f"error: {exc}\n")
        return EXIT_USAGE
    except InconclusiveError as exc:
        sys.stderr.write(f"inconclusive: {exc}\n")
        return EXIT_INCONCLUSIVE
    except SourceError as exc:
        sys.stderr.write(f"error: {exc}\n")
        return EXIT_SOURCE


if __name__ == "__main__":
    raise SystemExit(main())
